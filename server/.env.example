# Copy to server/.env on your OWN VPS. NEVER COMMIT THE REAL .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_FILE=/var/lib/esn-business/esn.sqlite
PUBLIC_SITE_ORIGIN=https://esnoffical.com
API_PUBLIC_URL=https://api.esnoffical.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.esnoffical.com/v1/auth/discord/callback
STAFF_DISCORD_IDS=
# Stripe price IDs correspond to the 11 real MONTHLY recurring prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS_JSON={}
# Pterodactyl application API: NEVER expose this key to Vite/frontend.
PTERODACTYL_URL=https://panel.esnoffical.com
PTERODACTYL_API_KEY=
PTERODACTYL_NODE_ID=
PTERODACTYL_ALLOCATION_ID=
PTERODACTYL_EGG_ID=
PTERODACTYL_DOCKER_IMAGE=
PTERODACTYL_STARTUP=
PTERODACTYL_ENV_JSON={}
# Node 3 staging uses separate NODEJS/PYTHON egg settings; no automatic guessing.
PTERODACTYL_NODEJS_EGG_ID=
PTERODACTYL_NODEJS_DOCKER_IMAGE=
PTERODACTYL_NODEJS_STARTUP=
PTERODACTYL_NODEJS_ENV_JSON={}
PTERODACTYL_PYTHON_EGG_ID=
PTERODACTYL_PYTHON_DOCKER_IMAGE=
PTERODACTYL_PYTHON_STARTUP=
PTERODACTYL_PYTHON_ENV_JSON={}
# Separate manual-provisioning safety lock. Leave false until final live preflight.
PTERODACTYL_PROVISIONING_ENABLED=false
# Never automatically provision a server from a payment or signup.
AUTO_PROVISION=false
